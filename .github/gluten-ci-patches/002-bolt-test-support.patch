 import org.apache.hadoop.fs.{FileSystem, Path}
+import org.scalactic.source.Position
+import org.scalatest.Tag

 class BoltIcebergSuite extends IcebergSuite {
+  // Bolt has no native Iceberg connector. Keep coverage that disables native reads
+  // and verifies that ordinary Parquet scans can still be offloaded.
+  override protected def test(testName: String, testTags: Tag*)(testFun: => Any)(implicit
+      pos: Position): Unit = {
+    if (testName == "disabling iceberg native read keeps other scans offloaded") {
+      super.test(testName, testTags: _*)(testFun)
+    } else {
+      super.ignore(testName, testTags: _*)(testFun)
+    }
+  }
+
   private def hasHadoopOpenFileApi: Boolean = {
     try {
       classOf[FileSystem].getMethod("openFile", classOf[Path])
