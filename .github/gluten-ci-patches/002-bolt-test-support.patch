+          previous.put(key, System.getProperty(key));
+          System.setProperty(key, value.toString());
+        });
+    context.getStore(NAMESPACE).put("previous", previous);
+  }
+
+  @Override
+  public void beforeEach(ExtensionContext context) {
+    SparkSession session = SparkSession.getDefaultSession().get();
+    TestConfUtil.GLUTEN_CONF.forEach(
+        (key, value) ->
+            assertThat(session.sparkContext().getConf().get(key))
+                .as("Inherited Iceberg fixtures must run with Gluten: %s", key)
+                .isEqualTo(value.toString()));
+  }
+
+  @Override
+  @SuppressWarnings("unchecked")
+  public void afterAll(ExtensionContext context) {
+    Map<String, String> previous = context.getStore(NAMESPACE).remove("previous", Map.class);
+    previous.forEach(
+        (key, value) -> {
+          if (value == null) {
+            System.clearProperty(key);
+          } else {
+            System.setProperty(key, value);
+          }
+        });
+  }
+}
