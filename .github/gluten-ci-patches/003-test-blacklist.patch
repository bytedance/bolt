+package org.apache.gluten.utils
+
+import org.scalactic.source.Position
+import org.scalatest.Tag
+import org.scalatest.funsuite.AnyFunSuiteLike
+
+import java.nio.charset.StandardCharsets.UTF_8
+import java.nio.file.{Files, Paths}
+
+import scala.collection.JavaConverters._
+import scala.collection.mutable
+import scala.util.control.NonFatal
+
+/** Registers exact external exclusions as ignored tests, before their bodies can execute. */
+trait GlutenTestBlacklist extends AnyFunSuiteLike {
+  protected def glutenTestBlacklist: Set[(String, String)] = GlutenTestBlacklist.entries
+
+  override protected def test(testName: String, testTags: Tag*)(testFun: => Any)(implicit
+      pos: Position): Unit = {
+    if (glutenTestBlacklist.contains((getClass.getCanonicalName, testName))) {
+      super.ignore(testName, testTags: _*)(testFun)
+    } else {
+      super.test(testName, testTags: _*)(testFun)
+    }
+  }
+}
+
+object GlutenTestBlacklist {
+  // Unset means disabled. A configured file must be readable and contain unique
+  // canonical suite#exact test name entries, optionally prefixed with [Spark/Scala]; blank lines and # comments are allowed.
+  private lazy val entries = load(sys.env.get("GLUTEN_TEST_BLACKLIST"))
+
+  private[gluten] def load(path: Option[String]): Set[(String, String)] = {
+    path.map {
+      file =>
+        val lines =
+          try {
+            require(file.nonEmpty, "empty path")
+            Files.readAllLines(Paths.get(file), UTF_8).asScala
+          } catch {
+            case NonFatal(e) =>
+              throw new IllegalArgumentException(s"Cannot read GLUTEN_TEST_BLACKLIST '$file'", e)
+          }
+        val entries = mutable.Set.empty[(String, String)]
+        val seen = mutable.Set.empty[String]
+        val sparkVersion = org.apache.spark.SPARK_VERSION.split("\\.").take(2).mkString(".")
+        val scalaVersion =
+          scala.util.Properties.versionNumberString.split("\\.").take(2).mkString(".")
+        val scoped = "\\[(\\d+\\.\\d+)/(\\d+\\.\\d+)\\](.+)".r
+        lines.zipWithIndex.foreach {
+          case (line, index) if line.trim.nonEmpty && !line.trim.startsWith("#") =>
+            val location = s"GLUTEN_TEST_BLACKLIST $file:${index + 1}"
+            val (matchesVersion, entry) = line match {
+              case scoped(spark, scala, value) =>
+                (spark == sparkVersion && scala == scalaVersion, value)
+              case value => (true, value)
+            }
+            val separator = entry.indexOf('#')
+            require(separator > 0, s"$location: expected canonical suite#exact test name")
+            val suite = entry.substring(0, separator)
+            val testName = entry.substring(separator + 1)
+            require(
+              suite.matches("[A-Za-z_$][A-Za-z0-9_$]*(\\.[A-Za-z_$][A-Za-z0-9_$]*)+") &&
+                testName.trim.nonEmpty,
+              s"$location: expected canonical suite#exact test name"
+            )
+            require(seen.add(line), s"$location: duplicate entry '$line'")
+            if (matchesVersion) {
+              entries.add((suite, testName))
+            }
+          case _ =>
+        }
+        entries.toSet
+    }.getOrElse(Set.empty)
+  }
+}
