+package org.apache.gluten.utils
+
+import org.apache.spark.sql.{GlutenQueryTest, GlutenTestsBaseTrait, SparkSession}
+
+import org.scalatest.{Args, Reporter}
+import org.scalatest.events.{Event, TestFailed, TestIgnored}
+import org.scalatest.funsuite.AnyFunSuite
+
+import java.nio.charset.StandardCharsets.UTF_8
+import java.nio.file.Files
+
+import scala.collection.mutable.ArrayBuffer
+
+class GlutenTestBlacklistSuite extends AnyFunSuite {
+  private val fixtureSuiteName = "org.apache.gluten.utils.BlacklistFixture"
+
+  private def withBlacklist(contents: String)(f: String => Unit): Unit = {
+    val path = Files.createTempFile("gluten-blacklist", ".txt")
+    try {
+      Files.write(path, contents.getBytes(UTF_8))
+      f(path.toString)
+    } finally {
+      Files.delete(path)
+    }
+  }
+
+  test("an absent blacklist leaves all tests enabled") {
+    val fixture = new BlacklistFixture(GlutenTestBlacklist.load(None))
+    val status = fixture.run(None, Args(new RecordingReporter))
+    assert(status.succeeds())
+    assert(fixture.executed.toSeq == Seq("listed # case", "listed # case suffix", "unlisted"))
+  }
+
+  test("comments and blank lines are allowed and test names retain hashes") {
+    withBlacklist(s"# comment\n\n$fixtureSuiteName#listed # case\n") {
+      path =>
+        assert(GlutenTestBlacklist.load(Some(path)) == Set((fixtureSuiteName, "listed # case")))
+    }
+  }
+
+  test("version scoped exclusions do not suppress other Spark or Scala versions") {
+    val spark = org.apache.spark.SPARK_VERSION.split("\\.").take(2).mkString(".")
+    val scalaVersion = scala.util.Properties.versionNumberString.split("\\.").take(2).mkString(".")
+    withBlacklist(
+      s"[$spark/$scalaVersion]$fixtureSuiteName#listed # case\n" +
+        s"[0.0/$scalaVersion]$fixtureSuiteName#unlisted\n" +
+        s"[$spark/0.0]$fixtureSuiteName#unlisted\n") {
+      path =>
+        assert(GlutenTestBlacklist.load(Some(path)) == Set((fixtureSuiteName, "listed # case")))
+    }
+  }
+
+  test("only the exact suite and test pair is ignored before executing its body") {
+    withBlacklist(s"$fixtureSuiteName#listed # case\n") {
+      path =>
+        val fixture = new BlacklistFixture(GlutenTestBlacklist.load(Some(path)))
+        val reporter = new RecordingReporter
+        assert(fixture.run(None, Args(reporter)).succeeds())
+        assert(fixture.executed.toSeq == Seq("listed # case suffix", "unlisted"))
+        assert(reporter.events.collect { case e: TestIgnored => e.testName }.toSeq ==
+          Seq("listed # case"))
+    }
+  }
+
+  test("suite names and test names do not match by prefix, pattern, or case") {
+    val entries = Set(
+      (fixtureSuiteName + "Other", "listed # case"),
+      (fixtureSuiteName, "listed"),
+      (fixtureSuiteName, "listed.*"),
+      (fixtureSuiteName, "Listed # case"))
+    val fixture = new BlacklistFixture(entries)
+    assert(fixture.run(None, Args(new RecordingReporter)).succeeds())
+    assert(fixture.executed.size == 3)
+  }
+
+  test("unlisted failures still fail the suite") {
+    val fixture =
+      new BlacklistFixture(Set((fixtureSuiteName, "listed # case")), failUnlisted = true)
+    val reporter = new RecordingReporter
+    assert(!fixture.run(None, Args(reporter)).succeeds())
+    assert(reporter.events.collect { case e: TestFailed => e.testName }.toSeq == Seq("unlisted"))
+  }
+
+  test("Spark UT registration applies the blacklist after adding the Gluten prefix") {
+    val fixture = new SparkBlacklistFixture(
+      Set(("org.apache.gluten.utils.SparkBlacklistFixture", "Gluten - listed")))
+    val reporter = new RecordingReporter
+    assert(fixture.run(None, Args(reporter)).succeeds())
+    assert(reporter.events.collect { case e: TestIgnored => e.testName }.toSeq ==
+      Seq("Gluten - listed"))
+  }
+
+  test("backend query test registration applies the same blacklist") {
+    val fixture = new QueryBlacklistFixture(
+      Set(("org.apache.gluten.utils.QueryBlacklistFixture", "listed")))
+    assert(fixture.tags("listed").contains("org.scalatest.Ignore"))
+    assert(!fixture.tags.getOrElse("unlisted", Set.empty).contains("org.scalatest.Ignore"))
+  }
+
+  test("malformed entries fail with their path and line number") {
+    Seq("missing separator", "suite#test", "org.example.Suite#", "org.example.*#test")
+      .foreach {
+        entry =>
+          withBlacklist(s"# comment\n$entry\n") {
+            path =>
+              val error = intercept[IllegalArgumentException] {
+                GlutenTestBlacklist.load(Some(path))
+              }
+              assert(error.getMessage.contains(path))
+              assert(error.getMessage.contains(":2"))
+          }
+      }
+  }
+
+  test("duplicate entries fail with their path and line number") {
+    withBlacklist(s"$fixtureSuiteName#listed # case\n$fixtureSuiteName#listed # case\n") {
+      path =>
+        val error = intercept[IllegalArgumentException] {
+          GlutenTestBlacklist.load(Some(path))
+        }
+        assert(error.getMessage.contains(path))
+        assert(error.getMessage.contains(":2"))
+    }
+  }
+
+  test("a configured missing file or empty path fails clearly") {
+    val missing = Files.createTempFile("gluten-blacklist-missing", ".txt")
+    Files.delete(missing)
+    Seq(missing.toString, "").foreach {
+      path =>
+        val error = intercept[IllegalArgumentException] {
+          GlutenTestBlacklist.load(Some(path))
+        }
+        assert(error.getMessage.contains("GLUTEN_TEST_BLACKLIST"))
+    }
+  }
+}
+
+private class RecordingReporter extends Reporter {
+  val events: ArrayBuffer[Event] = ArrayBuffer.empty
+  override def apply(event: Event): Unit = events += event
+}
+
+private class BlacklistFixture(
+    override protected val glutenTestBlacklist: Set[(String, String)],
+    failUnlisted: Boolean = false)
+  extends AnyFunSuite
+  with GlutenTestBlacklist {
+  val executed: ArrayBuffer[String] = ArrayBuffer.empty
+  Seq("listed # case", "listed # case suffix", "unlisted").foreach {
+    name =>
+      test(name) {
+        executed += name
+        if (name == "unlisted" && failUnlisted) {
+          fail("unlisted regression")
+        }
+      }
+  }
+}
+
+private class SparkBlacklistFixture(
+    override protected val glutenTestBlacklist: Set[(String, String)])
+  extends AnyFunSuite
+  with GlutenTestsBaseTrait {
+  override protected def shouldRun(testName: String): Boolean = true
+  testGluten("listed")(fail("blacklisted Spark test body executed"))
+  testGluten("unlisted")(assert(true))
+}
+
+private class QueryBlacklistFixture(
+    override protected val glutenTestBlacklist: Set[(String, String)])
+  extends GlutenQueryTest {
+  override protected def spark: SparkSession = null
+  test("listed")(fail("blacklisted backend test body executed"))
+  test("unlisted")(assert(true))
+}
