FROM debian:bookworm

ENV CMAKE_VERSION=3.31.10
ENV MOLD_VERSION=2.42.1

ARG GCC_VERSION=16.2.0
ARG CLANG_VERSION=22.1.8
ARG TOOLCHAIN_BUILD_DIR=/tmp/toolchain-build

ARG DEB_REGION=""
ARG https_proxy=""
ARG no_proxy=""

# check if deb region is not empty string. If it is, replace the default debian repository with the one for the region.
RUN if [ "$DEB_REGION" != "" ]; then \
    sed -i "s|http://deb.debian.org/debian|http://ftp.${DEB_REGION}.debian.org/debian|g" /etc/apt/sources.list.d/debian.sources; \
fi

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    curl \
    libgmp-dev \
    libmpc-dev \
    libmpfr-dev \
    wget \
    tar \
    sudo \
    bash \
    vim \
    git \
    gdb \
    python3 \
    python3-pip \
    python3-virtualenv \
    ssh-client \
    ninja-build \
    bison \
    flex \
    gawk \
    bzip2 \
    xz-utils \
    maven \
    net-tools \
    telnet \
    ssh \
    rsync \
    openssh-server \
    ccache \
    binutils-dev \
    make \
    automake \
    autoconf \
    htop \
    less \
    nodejs \
    npm \
    bsdextrautils \
    locales \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /bin/bash /bin/sh


# Install GCC 16 alongside the GCC 12 compiler provided by the base image.
RUN set -eux; \
    mkdir -p "${TOOLCHAIN_BUILD_DIR}"; \
    cd "${TOOLCHAIN_BUILD_DIR}"; \
    wget --progress=dot:mega \
        "https://mirrors.aliyun.com/gnu/gcc/gcc-${GCC_VERSION}/gcc-${GCC_VERSION}.tar.gz"; \
    tar -xzf "gcc-${GCC_VERSION}.tar.gz"; \
    mkdir -p "${TOOLCHAIN_BUILD_DIR}/gcc-build-${GCC_VERSION}"; \
    cd "${TOOLCHAIN_BUILD_DIR}/gcc-build-${GCC_VERSION}"; \
    "${TOOLCHAIN_BUILD_DIR}/gcc-${GCC_VERSION}/configure" \
        --prefix="/opt/gcc-${GCC_VERSION}" \
        --enable-languages=c,c++ \
        --disable-checking \
        --disable-multilib; \
    make -j "$(nproc)" || { \
        find . -path '*/libatomic/config.log' -exec tail -n 300 {} \;; \
        exit 1; \
    }; \
    make install-strip; \
    ln -sf "/opt/gcc-${GCC_VERSION}/bin/gcc" /usr/local/bin/gcc-16; \
    ln -sf "/opt/gcc-${GCC_VERSION}/bin/g++" /usr/local/bin/g++-16; \
    libstdcxx_dir="/lib/$(arch)-linux-gnu"; \
    latest_libstdcxx="$(find "/opt/gcc-${GCC_VERSION}/lib64" -maxdepth 1 \
        -name 'libstdc++.so.6.0.*[0-9]' -printf '%f\n' | sort -V | tail -n 1)"; \
    test -n "${latest_libstdcxx}"; \
    cp "/opt/gcc-${GCC_VERSION}/lib64/${latest_libstdcxx}" "${libstdcxx_dir}/"; \
    ln -sf "${libstdcxx_dir}/${latest_libstdcxx}" "${libstdcxx_dir}/libstdc++.so.6"; \
    ln -sf "${libstdcxx_dir}/${latest_libstdcxx}" "${libstdcxx_dir}/libstdc++.so"; \
    ln -sf "/usr/local/lib64/libstdc++.so.6" "${libstdcxx_dir}/libstdc++.so"; \
    ldconfig; \
    gcc-16 --version; \
    g++-16 --version; \
    rm -rf "${TOOLCHAIN_BUILD_DIR:?}"/*

RUN arch=$(arch) && \
    https_proxy=${https_proxy} \
    curl -L -# -o /tmp/cmake.tar.gz https://github.com/Kitware/CMake/releases/download/v$CMAKE_VERSION/cmake-$CMAKE_VERSION-linux-${arch}.tar.gz  && \
    tar -xzvf /tmp/cmake.tar.gz -C /opt && \
    ln -s /opt/cmake-$CMAKE_VERSION-linux-${arch}/bin/cmake /usr/local/bin/cmake && \
    ln -s /opt/cmake-$CMAKE_VERSION-linux-${arch}/bin/ctest /usr/local/bin/ctest && \
    rm /tmp/cmake.tar.gz

# Install Clang 22 and the CI tools that are distributed with LLVM.
COPY assets/patches/llvm-pr220492.patch /tmp/llvm-pr220492.patch
RUN set -eux; \
    mkdir -p "${TOOLCHAIN_BUILD_DIR}"; \
    cd "${TOOLCHAIN_BUILD_DIR}"; \
    wget --progress=dot:mega -O "llvm-project-${CLANG_VERSION}.tar.gz" \
        "https://github.com/llvm/llvm-project/archive/refs/tags/llvmorg-${CLANG_VERSION}.tar.gz"; \
    tar -xzf "llvm-project-${CLANG_VERSION}.tar.gz"; \
    cd "llvm-project-llvmorg-${CLANG_VERSION}"; \
    git apply --check /tmp/llvm-pr220492.patch; \
    git apply /tmp/llvm-pr220492.patch; \
    rm /tmp/llvm-pr220492.patch; \
    cd "${TOOLCHAIN_BUILD_DIR}"; \
    cmake -S "llvm-project-llvmorg-${CLANG_VERSION}/llvm" -B llvm-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX="/opt/clang-${CLANG_VERSION}" \
        -DLLVM_ENABLE_PROJECTS="clang;clang-tools-extra;lld" \
        -DLLVM_DISTRIBUTION_COMPONENTS="clang;clang-resource-headers;clang-tidy;lld;llvm-ar;llvm-ranlib" \
        -DLLVM_BUILD_TESTS=OFF \
        -DLLVM_INCLUDE_TESTS=OFF \
        -DLLVM_BUILD_DOCS=OFF \
        -DLLVM_INCLUDE_DOCS=OFF \
        -DLLVM_BUILD_EXAMPLES=OFF \
        -DLLVM_INCLUDE_EXAMPLES=OFF; \
    cmake --build llvm-build --target install-distribution-stripped \
        --parallel "$(nproc)"; \
    ln -sf "/opt/clang-${CLANG_VERSION}/bin/clang" /usr/local/bin/clang-22; \
    ln -sf "/opt/clang-${CLANG_VERSION}/bin/clang++" /usr/local/bin/clang++-22; \
    clang-22 --version; \
    clang++-22 --version; \
    /opt/clang-${CLANG_VERSION}/bin/clang-tidy --version; \
    /opt/clang-${CLANG_VERSION}/bin/ld.lld --version; \
    test -x "/opt/clang-${CLANG_VERSION}/bin/llvm-ar"; \
    test -x "/opt/clang-${CLANG_VERSION}/bin/llvm-ranlib"; \
    rm -rf "${TOOLCHAIN_BUILD_DIR:?}"/*

ENV PATH="/opt/clang-${CLANG_VERSION}/bin:${PATH}"

RUN set -eux; \
    mold_archive="/tmp/mold-${MOLD_VERSION}-$(arch)-linux.tar.gz"; \
    https_proxy=${https_proxy} curl -fL -o "${mold_archive}" \
        "https://github.com/rui314/mold/releases/download/v${MOLD_VERSION}/mold-${MOLD_VERSION}-$(arch)-linux.tar.gz"; \
    tar -C /usr/local --strip-components=1 -xzf "${mold_archive}"; \
    rm "${mold_archive}"


# License header check tool
RUN https_proxy=${https_proxy} curl -L -# -o /tmp/skywalking-eyes-bin.tgz https://dlcdn.apache.org/skywalking/eyes/0.8.0/skywalking-license-eye-0.8.0-bin.tgz && \
    mkdir -p /opt/skywalking-license-eye && \
    sudo tar -C /opt/skywalking-license-eye --strip-components=1 -xzf /tmp/skywalking-eyes-bin.tgz && \
    rm /tmp/skywalking-eyes-bin.tgz

ENV PATH="/opt/skywalking-license-eye/bin/linux:${PATH}"

RUN export arch=$(arch | sed 's/^aarch64$/arm64/; s/^x86_64$/amd64/') && \
    export https_proxy=${https_proxy} && \
    export filename=go1.25.5.linux-${arch}.tar.gz && \
    curl -L -O --output-dir /tmp https://go.dev/dl/${filename} && \
    sudo rm -rf /usr/local/bin/go && tar -C /usr/local -xzf /tmp/${filename} && \
    rm /tmp/${filename}
ENV PATH="/usr/local/go/bin:${PATH}"

# Set up default python virtualenv, and make it the default on PATH
RUN virtualenv -p python3 /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && \
    rm -f requirements.txt

ARG USERNAME=code
ARG USER_UID=1000
ARG USER_GID=$USER_UID

RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME \
    && echo $USERNAME ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

USER $USERNAME

# Generate Locales
RUN sudo sed -i 's/^# *\(en_US.UTF-8\)/\1/' /etc/locale.gen && \
    sudo locale-gen && \
    echo "export LC_ALL=en_US.UTF-8" >> ~/.bashrc && \
    echo "export LANG=en_US.UTF-8" >> ~/.bashrc && \
    echo "export LANGUAGE=en_US.UTF-8" >> ~/.bashrc


ENV SHELL=/bin/bash

WORKDIR /workspace

ENTRYPOINT ["/bin/bash", "-c"]
