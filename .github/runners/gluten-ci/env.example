# Copy to /etc/bolt-gluten-ci.env, mode 0600. Source it as root.
# Replace placeholders before running ci.sh. Keep both PATs in separate files.
export WATCH_REPOSITORY=apache/gluten
export HOST_DATA_DIR=/data
export CI_IMAGE=localhost:5000/bolt-ci:20260921
export DOCKER_NETWORK=bolt-gluten-ci-workers
export READ_TOKEN_FILE=/etc/bolt-gluten-ci-secrets/reader
export BOT_TOKEN_FILE=/etc/bolt-gluten-ci-secrets/writer
export MAINTAINER_LOGINS=''

# Full Git commit of the Bolt ENGINE to build; independent of the bundled driver.
export BOLT_REF=REPLACE_WITH_40_LOWERCASE_HEX
# Optional independent local seed containing exactly the pinned commit.
# export BOLT_CHECKOUT_SEED=/root/projects/bolt

# Explicit real validation scope. Replace with a single existing test PR.
export ONLY_PR=REPLACE_WITH_PR_NUMBER

# Existing ECS cache. Get the full container ID using the label command in the runbook.
export CONAN_REMOTE=http://host.docker.internal:9300
export CONAN_CACHE_CONTAINER=REPLACE_WITH_64_HEX_CONTAINER_ID
export ARROW_CACHE_SCRIPT="$HOST_DATA_DIR/conan-source-cache/arrow-cache.py"
export ARROW_SOURCE_DIR="$HOST_DATA_DIR/conan-source-cache/s"
export CCACHE_SEED_DIR="$HOST_DATA_DIR/ccache-data"

export POLL_SECONDS=60
export MAX_PARALLEL=4
export QUEUE_TIMEOUT_SECONDS=1800
export TASK_TIMEOUT_SECONDS=21600
export CPUS=16
export MEMORY_GIB=50
export MIN_FREE_GIB=80
export STATUS_PUBLISHING=false
